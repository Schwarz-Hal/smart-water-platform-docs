{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "title", "document_type", "document_version", "status", "locale", "audience", "owners", "reviewed_at", "summary"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
    "title": {"type": "string", "minLength": 2},
    "document_type": {"enum": ["platform", "quick_start", "user_guide", "scenario", "algorithm", "api", "development", "operations", "acceptance"]},
    "document_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "status": {"enum": ["draft", "published", "deprecated"]},
    "locale": {"const": "zh-CN"},
    "audience": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "related_modules": {"type": "array", "items": {"type": "string"}},
    "related_operators": {"type": "array", "items": {"type": "string"}},
    "related_apis": {"type": "array", "items": {"type": "string"}},
    "owners": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reviewed_at": {"type": "string"},
    "summary": {"type": "string", "minLength": 10}
  },
  "additionalProperties": true
}

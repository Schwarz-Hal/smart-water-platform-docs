{
  "name": "smart-water-platform-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "npm run progress && docusaurus start",
    "build": "node scripts/build-publication.mjs --site",
    "build:site": "docusaurus build",
    "build:search": "pagefind --site build --output-subdir pagefind",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "lint": "markdownlint-cli2 \"docs/**/*.md\" \"templates/**/*.md\" \"STYLE_GUIDE.md\" \"CONTRIBUTING.md\" \"README.md\"",
    "validate": "node scripts/validate-docs.mjs",
    "progress": "node scripts/calculate-progress.mjs",
    "test": "node --test scripts/**/*.test.mjs",
    "export": "node scripts/export-docs.mjs",
    "snapshot": "node scripts/create-snapshot.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "@pagefind/default-ui": "^1.4.0",
    "katex": "^0.16.22",
    "prism-react-renderer": "^2.3.0",
    "remark-math": "^6.0.0",
    "rehype-katex": "^7.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2",
    "ajv": "^8.17.1",
    "gray-matter": "^4.0.3",
    "markdownlint-cli2": "^0.20.0",
    "pagefind": "^1.4.0",
    "yaml": "^2.6.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
